# Maintainer: Timofei Granovskii <t.stifix@gmail.com>
# One-time migration of the former locally installed launch wrappers.

_remove_known_file() {
    local path=$1 expected=$2 actual
    [ -f "$path" ] || return 0
    actual=$(sha256sum "$path")
    if [ "${actual%% *}" = "$expected" ]; then
        rm -- "$path"
    else
        printf 'waydroid-baikal: preserved modified legacy file %s\n' "$path"
    fi
}

_migrate_launchers() {
    local launcher
    for launcher in /usr/share/applications/waydroid.*.desktop; do
        [ -f "$launcher" ] || continue
        if grep -q '^Exec=/usr/local/bin/waydroid-launch-app ' "$launcher"; then
            sed -i \
                -e 's@^Exec=/usr/local/bin/waydroid-launch-app --intent @Exec=/usr/bin/waydroid app intent @' \
                -e 's@^Exec=/usr/local/bin/waydroid-launch-app @Exec=/usr/bin/waydroid app launch @' \
                "$launcher"
        fi
    done
}

_migrate_legacy_input_config() {
    local config=${1:-/var/lib/waydroid/lxc/waydroid/config}
    if [ -f "$config" ]; then
        # Native core owns the device policy and its include. Retire only the
        # obsolete mount hook without weakening the current device allowlist.
        sed -i \
            -e '\#^[[:space:]]*lxc\.hook\.mount[[:space:]]*=[[:space:]]*/usr/local/lib/waydroid-sync-input-devices[[:space:]]*$#d' \
            "$config"
    fi
}

_migrate_legacy_services() {
    local unit link
    _remove_known_file /etc/systemd/system/waydroid-hwdec.service \
        2082bbf646618671b60c3130240ec797bec3ab5225f68625ff157278e94be214
    _remove_known_file /usr/local/bin/waydroid-hwdec-helper \
        2da015966d157877b52c00931ec9ca16186afd5f509367f1c781bbefefe70641
    _remove_known_file /etc/systemd/system/waydroid-container.service.d/60-hwdec-runtime-dir.conf \
        bd8daa1903370ed84fdad2c01feee4590626f1d990df7a1255e6f03a0d9a6777
    _remove_known_file /etc/systemd/system/waydroid-container.service.d/20-touch-controls.conf \
        0db8ec222d770018e441037c9803c569630b24284368057d13a1268987cb6f9b
    link=/etc/systemd/system/multi-user.target.wants/waydroid-hwdec.service
    if [ -L "$link" ] && [ ! -e /etc/systemd/system/waydroid-hwdec.service ]; then
        case $(readlink "$link") in
            /etc/systemd/system/waydroid-hwdec.service|../waydroid-hwdec.service)
                rm -- "$link"
                ;;
        esac
    fi
    for unit in /etc/systemd/user/waydroid-session.service \
                /etc/xdg/systemd/user/waydroid-session.service; do
        _remove_known_file "$unit" 9f3d17753e6860446ad36aebad993691bbae18742125f596f1a78789e42a10a1
    done

    # Retire system-wide links without modifying users' home directories.
    for link in /etc/systemd/user/default.target.wants/waydroid-session.service \
                /etc/systemd/user/graphical-session-pre.target.wants/waydroid-session.service; do
        [ -L "$link" ] || continue
        case $(readlink "$link") in
            /etc/systemd/user/waydroid-session.service|/etc/xdg/systemd/user/waydroid-session.service)
                [ -e "$link" ] || rm -- "$link"
                ;;
        esac
    done

    _remove_known_file /etc/systemd/system/waydroid-boot-warmup.service \
        848f389b027c2af9c75610b6f85dcf26bc854a76811209c882ee93f29552da7a
    link=/etc/systemd/system/graphical.target.wants/waydroid-boot-warmup.service
    if [ -L "$link" ] && [ ! -e "$link" ]; then
        rm -- "$link"
    fi
    _remove_known_file /etc/systemd/system/waydroid-container.service.d/25-media-qos.conf \
        2447fe46dc8341ef487fab8dcb446bf3488d6a8f0c0d2099d0a788973f44bdb4
    _remove_known_file /etc/systemd/system/waydroid-container.service.d/35-cgroup-subtree-control.conf \
        d0067a562b92847374ffd6edfb7c55145212bfcb1ad4964cc03a5a89708ef50e
    _remove_known_file /usr/local/bin/waydroid-session-keeper \
        e1d6a34284fff268dc5d4b6b667d4957bbfed7aa4936dfaa49cb9f13d8f2a28f
    _remove_known_file /usr/local/bin/waydroid-launch-app \
        628472c200eee670c6255a58a90d35b3c9b946960f4bc0952262d0ac5abc35ec
    # Retired implementations are preserved in the private repository archival ref.
    _remove_known_file /usr/local/bin/waydroid-app-status \
        5eac6a7c0d2e7fa631f0bc477bae0af0dc32b99f41bec3c99648503499a243b2
    _remove_known_file /usr/local/bin/waydroid-kwin-gestures-watcher \
        93e75e4f3bd017a9e174cf6fa84b1aed190f1624f016211c0fe0625079d52bd1
    _remove_known_file /etc/systemd/user/waydroid-kwin-gestures.service \
        04569d986777488feaa8bbad9983fc9cb3d8ed00872defb33fe8afdc4fd03dec
    _remove_known_file /etc/xdg/systemd/user/waydroid-kwin-gestures.service \
        04569d986777488feaa8bbad9983fc9cb3d8ed00872defb33fe8afdc4fd03dec
    _remove_known_file /usr/local/lib/waydroid-route-cache-guard \
        86ee9e3128076a828784dd9c031e353631314ca868292c1d434f57977bf82b86
    _remove_known_file /etc/systemd/system/waydroid-route-cache-guard.service \
        e17851c16a031db7b64395af728b12b12d3e0d26d08b0243f50b10752046679b
    _remove_known_file /usr/local/lib/waydroid-panel-tune \
        5ddb164a08243402d6a10dd874f440cf503afbd252e6f1fc9f3798e0980633db
    _remove_known_file /etc/systemd/system/waydroid-panel-tune.service \
        fe2e42a3cc750e85ae89277529e027f0593693934a244179fc54830c1fed3ae4
    _remove_known_file /usr/local/lib/waydroid-permission-relaxer \
        76c80d78af55e6851d49666d4e327765327f994e6495085cb33d4581bee69cab
    _remove_known_file /etc/systemd/system/waydroid-permission-relaxer.service \
        8d5f568ad1d10ef597d412384b46b5ee5508db5e91fcd2c6196a89937536484a
    _remove_known_file /usr/lib/waydroid/tools/services/touch_controls_manager.py \
        7ae741a77609a0a2c00cc46e7e892e2ce913e7416669bca62187a016cf87e788
    _remove_known_file /usr/lib/waydroid/tools/actions/app_manager.py.before-launch-wrapper-20260531214112 \
        8112cf0de9a0af1ada52b9bbcdd027e501a7fab68178856a4470278ba272e264
    _remove_known_file /usr/lib/waydroid/tools/actions/app_manager.py.stock-before-stale-session-guard \
        473c748f75edba7d05e7df213c61ca885b3edd7ad62f45630398ded3538410b3
    _remove_known_file /usr/lib/waydroid/tools/actions/session_manager.py.before-touch-controls-20260531164549 \
        46144261fc74b01eef16020135efdc4370a58642015ee484a457f808fbe471b4
    _remove_known_file /usr/lib/waydroid/tools/interfaces/IPlatform.py.before-launch-wrapper-20260531214208 \
        e9016076ba33ec811534ffd64851be43b009b8f83c6e03c044d8cecb19607d49
    _remove_known_file /usr/lib/waydroid/tools/services/__init__.py.before-touch-controls-20260531164550 \
        11e16d6a2de802709fce733846b0d8b59538e202973ad94051e344b6771b80f5
    _remove_known_file /usr/lib/waydroid/tools/services/user_manager.py.before-launch-wrapper-20260531214112 \
        a74a5c2f03b629005fa0a66c8c331198995cb0336398f79700f65f295fb20ae0

    # Input is now owned by the Wayland HWC and the generated LXC policy.
    # Retire the old mount hook and oneshot synchronizer only when their
    # contents are the known local implementation.
    _remove_known_file /usr/local/lib/waydroid-sync-input-devices \
        895a963a1604d1dcad3e368ef09d1d303f7b5c104de9d0d6621adbd597cbd5f6
    _remove_known_file /etc/systemd/system/waydroid-input-sync.service \
        f79490c34d684eacc843bed6b56fad5bfc8909034c73c1492f42679bddc5bc99
    _remove_known_file /etc/systemd/system/waydroid-container.service.d/45-input-cgroup-allowlist.conf \
        f2f51ceb8f7c467dbd6d8484a0407e850d5733082f99b044879003d206345f20
    _remove_known_file /etc/systemd/system/waydroid-container.service.d/50-input-sync-post.conf \
        b13c4be66cd91625b259b367e6f427db07eaf431e4a4402383bb0d8a8ff85a15

    _migrate_legacy_input_config

}

post_install() {
    _migrate_launchers
    _migrate_legacy_services
}

post_upgrade() {
    post_install
}
