+/*
+ * The Wayland input reader consumes Linux input_event records from these
+ * FIFOs.  They are part of the HWC/Android interface and must exist before
+ * EventHub performs its initial device scan; creating them from a shell hook
+ * races that scan and loses input until the next restart.
+ */
+static bool
+ensure_input_fifo(int input_type)
+{
+    if (input_type < 0 || input_type >= INPUT_TOTAL)
+        return false;
+
+    const char *path = INPUT_PIPE_NAME[input_type];
+    // HWC runs as the host UID with Android's system group. InputReader can
+    // read through that group; HWC must never require CAP_CHOWN.
+    if (ensure_input_fifo_node(path, 0660, geteuid(), getegid()) != 0) {
+        ALOGE("Failed to prepare input FIFO %s: %s", path, strerror(errno));
+        return false;
+    }
+    return true;
+}
+
+static void
+close_input_pipe(struct display *display, int input_type)
+{
+    if (display->input_fd[input_type] != -1) {
+        close(display->input_fd[input_type]);
+        display->input_fd[input_type] = -1;
+    }
+}
