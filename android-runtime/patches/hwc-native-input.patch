+/* SPDX-License-Identifier: MIT */
+/* Maintainer: Timofei Granovskii <t.stifix@gmail.com> */
+#ifndef WAYDROID_INPUT_FIFO_H
+#define WAYDROID_INPUT_FIFO_H
+
+#include <errno.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/* Shared by the native bridge and its filesystem lifecycle test. */
+static inline int ensure_input_fifo_node(const char *path, mode_t mode,
+                                         uid_t owner, gid_t group)
+{
+    struct stat st;
+
+    if (lstat(path, &st) == 0) {
+        if (!S_ISFIFO(st.st_mode) && unlink(path) != 0 && errno != ENOENT)
+            return -1;
+    } else if (errno != ENOENT) {
+        return -1;
+    }
+
+    /* Also create the FIFO after removing a stale non-FIFO endpoint. */
+    if (mkfifo(path, mode) != 0 && errno != EEXIST)
+        return -1;
+    if (lstat(path, &st) != 0)
+        return -1;
+    if (!S_ISFIFO(st.st_mode)) {
+        errno = EINVAL;
+        return -1;
+    }
+    if (chmod(path, mode) != 0 || chown(path, owner, group) != 0)
+        return -1;
+    return 0;
+}
+
+#endif
