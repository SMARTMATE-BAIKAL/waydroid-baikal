@@ -1107,16 +1136,68 @@ window::layer& window::create_new_layer() {
 static int
 ensure_pipe(struct display* display, int input_type)
 {
+    struct stat fifo_stat {};
+    struct stat fd_stat {};
+
+    if (lstat(INPUT_PIPE_NAME[input_type], &fifo_stat) != 0 ||
+        !S_ISFIFO(fifo_stat.st_mode)) {
+        close_input_pipe(display, input_type);
+        if (!ensure_input_fifo(input_type))
+            return -1;
+    }
+
     if (display->input_fd[input_type] == -1) {
-        display->input_fd[input_type] = open(INPUT_PIPE_NAME[input_type], O_WRONLY | O_NONBLOCK);
+        /* Keep a read end as well so startup does not depend on EventHub's
+         * exact open order and never reports ENXIO while Android is booting. */
+        display->input_fd[input_type] = open(INPUT_PIPE_NAME[input_type], O_RDWR | O_NONBLOCK);
+        if (display->input_fd[input_type] == -1 && errno == ENOENT) {
+            /* Recover a removed FIFO once, without polling or shell hooks. */
+            if (ensure_input_fifo(input_type)) {
+                display->input_fd[input_type] = open(INPUT_PIPE_NAME[input_type],
+                                                      O_RDWR | O_NONBLOCK);
+            }
+        }
         if (display->input_fd[input_type] == -1) {
             ALOGE("Failed to open pipe to InputFlinger: %s", strerror(errno));
             return -1;
         }
+    } else if (fstat(display->input_fd[input_type], &fd_stat) != 0 ||
+               fd_stat.st_dev != fifo_stat.st_dev || fd_stat.st_ino != fifo_stat.st_ino) {
+        // A container restart can replace the FIFO while the HWC still holds
+        // the old inode. Reconnect on the next Wayland event instead of
+        // silently writing into an unlinked endpoint.
+        close_input_pipe(display, input_type);
+        return ensure_pipe(display, input_type);
     }
     return 0;
 }
 
+static ssize_t
+write_input_events(struct display *display, int input_type, const void *events, size_t size)
+{
+    if (ensure_pipe(display, input_type))
+        return -1;
+
+    const ssize_t result = write(display->input_fd[input_type], events, size);
+    if (result == static_cast<ssize_t>(size))
+        return result;
+
+    if (result >= 0) {
+        errno = EIO;
+        return result;
+    }
+
+    const int saved_errno = errno;
+    if (saved_errno == EPIPE || saved_errno == ENOENT || saved_errno == EBADF) {
+        close_input_pipe(display, input_type);
+        // Keep the endpoint available for EventHub. The next event will open
+        // it after the Android reader has accepted the new FIFO.
+        ensure_input_fifo(input_type);
+    }
+    errno = saved_errno;
+    return result;
+}
