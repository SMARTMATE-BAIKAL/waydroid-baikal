new file mode 100644
index 0000000..c88febc
--- /dev/null
+++ b/hwcomposer/tests/input-fifo-lifecycle.c
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: MIT */
+/* Maintainer: Timofei Granovskii <t.stifix@gmail.com> */
+
+/*
+ * Exercise the filesystem contract used by wayland-hwc for the Android input
+ * bridge.  This deliberately does not connect to Wayland or start Android;
+ * it verifies that a replaced FIFO is observable by comparing its inode with
+ * the descriptor held by the producer.
+ */
+
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include "../input-fifo.h"
+
+static int make_fifo(const char *path)
+{
+    return ensure_input_fifo_node(path, 0660, getuid(), getgid());
+}
+
+static bool same_fifo(const char *path, int fd)
+{
+    struct stat path_st;
+    struct stat fd_st;
+    return lstat(path, &path_st) == 0 && fstat(fd, &fd_st) == 0 &&
+           S_ISFIFO(path_st.st_mode) && S_ISFIFO(fd_st.st_mode) &&
+           path_st.st_dev == fd_st.st_dev && path_st.st_ino == fd_st.st_ino;
+}
+
+int main(void)
+{
+    char directory[] = "/tmp/waydroid-input-fifo.XXXXXX";
+    char path[PATH_MAX];
+    int reader = -1;
+    int writer = -1;
+    int result = EXIT_FAILURE;
+
+    if (!mkdtemp(directory)) {
+        perror("mkdtemp");
+        return EXIT_FAILURE;
+    }
+    if (snprintf(path, sizeof(path), "%s/wl_pointer_events", directory) >=
+        (int)sizeof(path))
+        goto cleanup;
+
+    /* A stale non-FIFO endpoint must be replaced by the native bridge. */
+    int stale = open(path, O_CREAT | O_WRONLY | O_CLOEXEC, 0600);
+    if (stale < 0 || close(stale) != 0 || make_fifo(path) != 0)
+        goto cleanup;
+
+    reader = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+    if (reader < 0)
+        goto cleanup;
+    writer = open(path, O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+    if (writer < 0 || !same_fifo(path, writer))
+        goto cleanup;
+
+    /* Repeated preparation must preserve an active reader's FIFO inode. */
+    if (make_fifo(path) != 0 || !same_fifo(path, writer))
+        goto cleanup;
+    struct stat st;
+    if (stat(path, &st) != 0 || (st.st_mode & 0777) != 0660 ||
+        st.st_uid != getuid() || st.st_gid != getgid())
+        goto cleanup;
+
+    /* Simulate a container restart replacing the endpoint while HWC lives. */
+    if (unlink(path) != 0 || make_fifo(path) != 0 || same_fifo(path, writer))
+        goto cleanup;
+
+    result = EXIT_SUCCESS;
+
+cleanup:
+    if (writer >= 0)
+        close(writer);
+    if (reader >= 0)
+        close(reader);
+    unlink(path);
+    rmdir(directory);
+    if (result != EXIT_SUCCESS)
+        fprintf(stderr, "input FIFO lifecycle probe failed: %s\n", strerror(errno));
+    return result;
+}
